{
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,
    "cmake.buildBeforeRun": true,
    "cmake.clearOutputBeforeBuild": false,
    "cmake.debugConfig": {
        "type": "cppdbg",
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb"
    },
    "cmake.options.statusBarVisibility": "visible",
    "cmake.options.advanced": {
        "testPreset": {
            "statusBarVisibility": "icon",
        },
        "ctest": {
            "statusBarVisibility": "icon"
        },
        "packagePreset": {
            "statusBarVisibility": "icon"
        },
        "cpack": {
            "statusBarVisibility": "icon"
        },
        "workflowPreset": {
            "statusBarVisibility": "icon"
        },
        "workflow": {
            "statusBarVisibility": "icon"
        }
    },
    // IntelliSense is handled by clangd (ms-vscode.cmake-tools is kept for debugging)
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.path": "/usr/bin/clangd",
    "C_Cpp.clang_format_path": "/usr/bin/clang-format",
    "editor.formatOnSave": true,
    // Disable strikethrough for deprecated symbols (e.g. C-style typedef structs from external headers)
    "editor.semanticTokenColorCustomizations": {
        "[*]": {
            "rules": {
                "*.deprecated": {
                    "strikeThrough": false
                }
            }
        }
    },
    "search.useIgnoreFiles": false,
    "search.exclude": {
        "**/.git/**": true,
        "**/build/**": true,
        "**/.cache/**": true
    },
    "files.associations": {
        "qstring": "cpp",
        "optional": "cpp",
        "chrono": "cpp",
        "mutex": "cpp",
        "array": "cpp",
        "atomic": "cpp",
        "*.tcc": "cpp",
        "cctype": "cpp",
        "clocale": "cpp",
        "cmath": "cpp",
        "condition_variable": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "cstring": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "deque": "cpp",
        "unordered_map": "cpp",
        "vector": "cpp",
        "exception": "cpp",
        "fstream": "cpp",
        "functional": "cpp",
        "future": "cpp",
        "initializer_list": "cpp",
        "iomanip": "cpp",
        "iosfwd": "cpp",
        "iostream": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "memory": "cpp",
        "new": "cpp",
        "ostream": "cpp",
        "ratio": "cpp",
        "sstream": "cpp",
        "stdexcept": "cpp",
        "streambuf": "cpp",
        "string_view": "cpp",
        "system_error": "cpp",
        "thread": "cpp",
        "type_traits": "cpp",
        "tuple": "cpp",
        "typeinfo": "cpp",
        "utility": "cpp",
        "variant": "cpp",
        "cinttypes": "cpp",
        "list": "cpp",
        "map": "cpp",
        "string": "cpp",
        "numeric": "cpp",
        "filesystem": "cpp",
        "strstream": "cpp",
        "bit": "cpp",
        "cstdarg": "cpp",
        "set": "cpp",
        "unordered_set": "cpp",
        "bitset": "cpp",
        "complex": "cpp",
        "typeindex": "cpp",
        "shared_mutex": "cpp",
        "csignal": "cpp",
        "random": "cpp",
        "semaphore": "cpp",
        "charconv": "cpp",
        "codecvt": "cpp",
        "algorithm": "cpp",
        "iterator": "cpp",
        "memory_resource": "cpp",
        "regex": "cpp",
        "compare": "cpp",
        "concepts": "cpp",
        "numbers": "cpp",
        "stop_token": "cpp",
        "any": "cpp",
        "ranges": "cpp",
        "source_location": "cpp",
        "coroutine": "cpp",
        "*.inc": "cpp",
        "*.ipp": "cpp",
        "qfontdatabase": "cpp"
    },
    "files.exclude": {
        "**/.git/**": true,
        "**/build/**": true,
        "**/.cache/**": true
    },
    "editor.rulers": [
        {
            "column": 120,
            "color": "#9c9c9c"
        }
    ]
}